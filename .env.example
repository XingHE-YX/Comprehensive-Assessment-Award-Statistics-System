APP_ENV=development
BIND_ADDR=127.0.0.1:3000
ADMIN_USERNAME=administrator
ADMIN_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_PHC_HASH
SESSION_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
DATABASE_URL=sqlite:data/app.db
UPLOAD_DIR=uploads
COOKIE_SECURE=false
MAX_BODY_BYTES=115343360
# Only a level (off/error/warn/info/debug/trace) is accepted; dependency logging stays off.
RUST_LOG=info
# Deployment only: a public domain, with DNS pointing to this server (no http:// prefix).
DOMAIN=assessment.example.org
